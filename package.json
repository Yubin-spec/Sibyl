{
  "name": "ai-bridge",
  "version": "0.5.0",
  "private": true,
  "description": "Local browser and macOS desktop bridge for collaboration between AI coding tools",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "start": "node control.mjs",
    "start:browser": "node browser.mjs",
    "verify:mcp": "node scripts/verify-real-mcp.mjs",
    "test": "node --test --test-concurrency=1 --test-timeout=30000 *.test.mjs",
    "build": "zsh build-app.sh 'dist/AI Bridge.app'"
  }
}
